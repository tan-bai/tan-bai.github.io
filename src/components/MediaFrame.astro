---
import Icons from './Icons.astro';

/*
 * 媒体框：单媒体三态 + 多媒体画廊
 *  - media: [{video|image, caption}]  多项 → 主画面 + 缩略图条画廊
 *  - image / video 单项               → 单画面（向后兼容）
 *  - 都没有                           → 安静占位（分组浅色 + 项目首字）
 */

interface MediaItem {
  video?: string;
  image?: string;
  caption?: string;
}

interface Props {
  title: string;
  group: string;
  image?: string;
  video?: string;
  media?: MediaItem[];
}

const { title, group, image, video, media } = Astro.props;

const groupTints: Record<string, [string, string]> = {
  sensing: ['#f2f5fa', '#e3eaf5'],
  detection: ['#f4f4ef', '#e8ead9'],
  embodied: ['#f3f1f7', '#e8e4f0'],
  llm: ['#f1f6f4', '#e0ece7'],
  hardware: ['#f6f3ea', '#ebe4d0'],
  opensource: ['#f6f4ef', '#ece7dc'],
};
const [t1, t2] = groupTints[group] ?? groupTints.sensing;
const glyph = title.replace(/[（(].*$/, '').trim().charAt(0);
const patId = `p-${group}-${title.length}`;

const items: MediaItem[] =
  media && media.length > 0
    ? media
    : ([{ image, video }] as MediaItem[]).filter((m) => m.image || m.video);
const isGallery = items.length > 1;
const isVideo = (src?: string) => !!src && /\.(mp4|webm|mov|m4v)$/i.test(src);
---

{items.length === 0 && (
  <div class="media-frame" style={`--tint1:${t1};--tint2:${t2};`}>
    <div class="media-placeholder" style={`background:linear-gradient(140deg,${t1},${t2});`}>
      <svg class="grid-art" aria-hidden="true">
        <defs>
          <pattern id={patId} width="28" height="28" patternUnits="userSpaceOnUse">
            <circle cx="1.5" cy="1.5" r="1" fill="rgba(23,63,122,0.09)" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill={`url(#${patId})`} />
      </svg>
      <span class="glyph">{glyph}</span>
    </div>
  </div>
)}

{items.length === 1 && (
  <div class="media-frame" style={`--tint1:${t1};--tint2:${t2};`}>
    {isVideo(items[0].video) ? (
      <video src={items[0].video} poster={items[0].image} controls preload="metadata" playsinline />
    ) : (
      <img src={items[0].image} alt={title} loading="lazy" />
    )}
    {isVideo(items[0].video) && (
      <span class="media-badge"><Icons name="video" size={11} />视频</span>
    )}
    {!isVideo(items[0].video) && items[0].image && (
      <span class="media-badge"><Icons name="image" size={11} />图片</span>
    )}
    {items[0].caption && <div class="g-cap">{items[0].caption}</div>}
  </div>
)}

{isGallery && (
  <div class="media-gallery" data-gallery tabindex="0" aria-label={`${title} 媒体画廊`}>
    <div class="media-frame g-stage">
      {items.map((m, i) => (
        <div class:list={['g-item', { active: i === 0 }]} data-caption={m.caption ?? ''}>
          {isVideo(m.video) ? (
            <video src={m.video} poster={m.image} controls preload={i === 0 ? 'metadata' : 'none'} playsinline />
          ) : (
            <img src={m.image} alt={m.caption ?? `${title} ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} />
          )}
        </div>
      ))}
      <span class="g-count">1 / {items.length}</span>
    </div>

    <div class="media-thumbs" role="tablist">
      {items.map((m, i) => (
        <button
          class:list={['g-thumb', { active: i === 0 }]}
          role="tab"
          aria-label={`媒体 ${i + 1}`}
          data-index={i}
        >
          {isVideo(m.video) ? (
            <span class="film"><Icons name="video" size={13} />{i + 1}</span>
          ) : (
            <img src={m.image} alt="" loading="lazy" />
          )}
        </button>
      ))}
    </div>

    <div class="g-cap"></div>
  </div>
)}

<script>
  // 画廊交互：缩略图/方向键切换，视频切走即暂停
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const frames = [...g.querySelectorAll<HTMLElement>('.g-item')];
    const thumbs = [...g.querySelectorAll<HTMLElement>('.g-thumb')];
    const cap = g.querySelector<HTMLElement>('.g-cap');
    const count = g.querySelector<HTMLElement>('.g-count');
    let cur = 0;

    const show = (i: number) => {
      cur = (i + frames.length) % frames.length;
      frames.forEach((f, j) => f.classList.toggle('active', j === cur));
      thumbs.forEach((t, j) => t.classList.toggle('active', j === cur));
      frames.forEach((f) => {
        const v = f.querySelector('video');
        if (v && !f.classList.contains('active')) v.pause();
      });
      // 懒加载：切换到某项时再加载视频元数据
      const v = frames[cur].querySelector('video');
      if (v && v.getAttribute('preload') === 'none') v.setAttribute('preload', 'metadata');
      if (cap) cap.textContent = frames[cur].dataset.caption ?? '';
      if (count) count.textContent = `${cur + 1} / ${frames.length}`;
    };

    thumbs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.index))));
    g.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(cur - 1);
      if (e.key === 'ArrowRight') show(cur + 1);
    });
    show(0);
  });
</script>
