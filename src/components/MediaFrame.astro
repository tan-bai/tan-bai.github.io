---
import Icons from './Icons.astro';

/*
 * 媒体框：三态渲染
 *  1. video 存在  → <video controls>（poster 可用 image）
 *  2. image 存在  → <img>
 *  3. 都没有      → 优雅占位（分组渐变 + 项目首字 + 提示）
 * 图片/视频放到 public/media/ 下，frontmatter 里写 /media/xxx 即可。
 */

interface Props {
  title: string;
  group: string;
  image?: string;
  video?: string;
}

const { title, group, image, video } = Astro.props;

const groupTints: Record<string, [string, string]> = {
  sensing: ['#f2f5fa', '#e3eaf5'],
  detection: ['#f4f4ef', '#e8ead9'],
  embodied: ['#f3f1f7', '#e8e4f0'],
  llm: ['#f1f6f4', '#e0ece7'],
  hardware: ['#f6f3ea', '#ebe4d0'],
  opensource: ['#f6f4ef', '#ece7dc'],
};
const [t1, t2] = groupTints[group] ?? groupTints.sensing;
const glyph = title.replace(/[（(].*$/, '').trim().charAt(0);
const isVideo = !!video && /\.(mp4|webm|mov|m4v)$/i.test(video);
---

<div class="media-frame" style={`--tint1:${t1};--tint2:${t2};`}>
  {isVideo ? (
    <video src={video} poster={image} controls preload="metadata" playsinline />
  ) : image ? (
    <img src={image} alt={title} loading="lazy" />
  ) : (
    <div class="media-placeholder" style={`background:linear-gradient(135deg,${t1},${t2});`}>
      <svg class="grid-art" aria-hidden="true">
        <defs>
          <pattern id={`p-${group}-${title.length}`} width="28" height="28" patternUnits="userSpaceOnUse">
            <circle cx="1.5" cy="1.5" r="1" fill="rgba(23,63,122,0.10)" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill={`url(#p-${group}-${title.length})`} />
      </svg>
      <span class="glyph">{glyph}</span>
      <span class="hint">MEDIA · 放入 public/media 后自动展示</span>
    </div>
  )}

  {isVideo && (
    <span class="media-badge"><Icons name="video" size={11} />视频</span>
  )}
  {!isVideo && image && (
    <span class="media-badge"><Icons name="image" size={11} />图片</span>
  )}
</div>
