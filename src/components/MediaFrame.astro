---
/*
 * 媒体框：三态渲染
 *  1. video 存在  → <video controls>（poster 可用 image）
 *  2. image 存在  → <img>
 *  3. 都没有      → 安静占位（分组浅色 + 项目首字）
 * 图片/视频放到 public/media/ 下，frontmatter 写 /media/xxx 即可。
 */

interface Props {
  title: string;
  group: string;
  image?: string;
  video?: string;
}

const { title, group, image, video } = Astro.props;

const groupTints: Record<string, [string, string]> = {
  sensing: ['#f2f4f8', '#e8edf4'],
  detection: ['#f5f4ef', '#ebead9'],
  embodied: ['#f4f2f6', '#eae7ef'],
  llm: ['#f1f5f3', '#e5ece8'],
  opensource: ['#f6f4ef', '#eeeadf'],
};
const [t1, t2] = groupTints[group] ?? groupTints.sensing;
const glyph = title.replace(/[（(].*$/, '').trim().charAt(0);
const isVideo = !!video && /\.(mp4|webm|mov|m4v)$/i.test(video);
const patId = `p-${group}-${title.length}`;
---

<div class="media-frame" style={`--tint1:${t1};--tint2:${t2};`}>
  {isVideo ? (
    <video src={video} poster={image} controls preload="metadata" playsinline />
  ) : image ? (
    <img src={image} alt={title} loading="lazy" />
  ) : (
    <div class="media-placeholder" style={`background:linear-gradient(140deg,${t1},${t2});`}>
      <svg class="grid-art" aria-hidden="true">
        <defs>
          <pattern id={patId} width="28" height="28" patternUnits="userSpaceOnUse">
            <circle cx="1.5" cy="1.5" r="1" fill="rgba(23,63,122,0.09)" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill={`url(#${patId})`} />
      </svg>
      <span class="glyph">{glyph}</span>
    </div>
  )}
</div>
