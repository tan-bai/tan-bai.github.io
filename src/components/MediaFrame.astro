---
import { posterOf, type MediaItem } from '../lib/media';

/*
 * 项目缩略媒体：显示第一项（视频静音循环 / 图片），点击在全站灯箱中查看全部。
 *  - media: [{video|image, caption}]  多项 → 右下角显示数量
 *  - image / video 单项                → 单项
 *  - 都没有                            → 排版占位（序号 + 英文标题）
 * 视频海报：未指定 image 时自动使用同名 `xxx-poster.webp`（public/media/ 下）。
 */

interface Props {
  title: string;
  titleEn?: string;
  image?: string;
  video?: string;
  media?: MediaItem[];
  index?: number;
}

const { title, titleEn, image, video, media, index } = Astro.props;

const items: MediaItem[] =
  media && media.length > 0
    ? media
    : ([{ image, video, caption: title }] as MediaItem[]).filter((m) => m.image || m.video);
const first = items[0];
const label = (titleEn ?? title).split('·')[0].trim();
---

{first ? (
  <button class="thumb" type="button" data-media={JSON.stringify(items)} aria-label={`查看「${title}」的媒体`}>
    {first.video ? (
      <video src={first.video} poster={posterOf(first)} muted loop playsinline preload="none" data-autoplay />
    ) : (
      <img src={first.image} alt={first.caption ?? title} loading="lazy" decoding="async" />
    )}
    {items.length > 1 && <span class="thumb-count">1 / {items.length}</span>}
  </button>
) : (
  <div class="thumb thumb-empty" aria-hidden="true">
    <span class="t-no">{index ? `No. ${String(index).padStart(2, '0')}` : ''}</span>
    <span class="t-name">{label}</span>
  </div>
)}
