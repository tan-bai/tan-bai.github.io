---
const certificates = [
  {
    "slug": "iot-national",
    "year": "2024",
    "title": "全国大学生物联网设计竞赛（华为杯）",
    "result": "全国二等奖"
  },
  {
    "slug": "challenge-shanghai",
    "year": "2025",
    "title": "挑战杯 · 上海市赛",
    "result": "一等奖 · 获奖证明"
  },
  {
    "slug": "energy-saving",
    "year": "2023",
    "title": "全国大学生节能减排社会实践与科技竞赛",
    "result": "全国三等奖"
  },
  {
    "slug": "innovation",
    "year": "2025",
    "title": "中国国际大学生创新大赛 · 上海赛区",
    "result": "铜奖"
  },
  {
    "slug": "robotics",
    "year": "2025",
    "title": "中国机器人及人工智能大赛 · 省级选拔赛",
    "result": "三等奖"
  },
  {
    "slug": "computer",
    "year": "2025",
    "title": "上海市大学生计算机应用能力大赛",
    "result": "二等奖"
  },
  {
    "slug": "challenge-campus",
    "year": "2025",
    "title": "挑战杯 · 上海师范大学选拔赛",
    "result": "一等奖"
  },
  {
    "slug": "mcm",
    "year": "2025",
    "title": "美国大学生数学建模竞赛（MCM）",
    "result": "Successful Participant"
  },
  {
    "slug": "creation",
    "year": "2024",
    "title": "上海市大学生创造杯大赛",
    "result": "三等奖"
  },
  {
    "slug": "iot-east",
    "year": "2024",
    "title": "全国大学生物联网设计竞赛 · 华东赛区",
    "result": "一等奖"
  },
  {
    "slug": "ic-design",
    "year": "2024",
    "title": "全国大学生集成电路创新创业大赛 · 华东赛区",
    "result": "二等奖"
  },
  {
    "slug": "metallography",
    "year": "2024",
    "title": "上海市大学生金相技能大赛",
    "result": "三等奖"
  },
  {
    "slug": "lanqiao",
    "year": "2024",
    "title": "蓝桥杯 · 上海赛区",
    "result": "三等奖"
  }
];
const patents = [
  {
    "title": "一种基于增强型对抗运动先验的双足机器人步态生成方法",
    "number": "CN120595629A",
    "date": "2025.09.05"
  },
  {
    "title": "一种基于改进YOLOv7的门框识别方法",
    "number": "CN120726591A",
    "date": "2025.09.30"
  },
  {
    "title": "一种基于位姿优化网络的6-DoF目标位姿估计方法",
    "number": "CN120747212A",
    "date": "2025.10.03"
  },
  {
    "title": "基于多模态深度学习的帕金森病患智能辅助进食系统",
    "number": "CN120748020A",
    "date": "2025.10.03"
  }
];
const patentMedia = JSON.stringify(patents.map(p => ({
  image: `/patents/${p.number}.webp`,
  caption: `${p.title} · ${p.number} · 发明专利申请公布`,
})));
const media = JSON.stringify(certificates.map(c => ({
  image: `/certificates/${c.slug}.webp`,
  caption: `${c.year} · ${c.title} · ${c.result}`,
})));
---
<section class="certificate-wall" id="certificates" aria-labelledby="certificate-title">
  <header class="certificate-heading">
    <div><h3 id="certificate-title">证书墙<span>13 份记录</span></h3></div>
    <p>点击放大查看，支持左右翻阅</p>
  </header>
  <div class="certificate-grid">
    {certificates.map((c, index) => (
      <article class="certificate-card">
        <button type="button" class="certificate-preview" data-media={media} data-media-index={index} aria-label={`放大查看：${c.title}，${c.result}`} aria-haspopup="dialog">
          <img src={`/certificates/${c.slug}-thumb.webp`} alt={`${c.title} · ${c.result}证书`} width="640" height="640" loading="lazy" decoding="async" />
          <span class="certificate-zoom" aria-hidden="true">↗</span>
        </button>
        <div class="certificate-caption">
          <h4>{c.result}</h4>
          <p>{c.title}</p>
          <div class="certificate-meta"><span>{c.year}</span><a href={`/certificates/${c.slug}.pdf`} target="_blank" rel="noopener" aria-label={`查看${c.title}的原始 PDF`}>PDF ↗</a></div>
        </div>
      </article>
    ))}
  </div>
</section>


<section class="certificate-wall" id="patent-documents" aria-labelledby="patent-documents-title">
  <header class="certificate-heading">
    <div><h3 id="patent-documents-title">专利与软著<span>{patents.length} 份专利 · 1 份软著</span></h3></div>
    <p>点击查看原件预览或打开完整 PDF</p>
  </header>
  <div class="certificate-grid">
    {patents.map((p, index) => (
      <article class="certificate-card">
        <button type="button" class="certificate-preview" data-media={patentMedia} data-media-index={index} aria-label={`查看专利首页：${p.title}`} aria-haspopup="dialog">
          <img src={`/patents/${p.number}-thumb.webp`} alt={`${p.title}申请公布文本首页`} width="640" height="640" loading="lazy" decoding="async" />
          <span class="certificate-zoom" aria-hidden="true">↗</span>
        </button>
        <div class="certificate-caption">
          <h4>{p.number}</h4>
          <p>{p.title}</p>
          <p class="patent-status">发明专利申请公布</p>
          <div class="certificate-meta"><span>{p.date}</span><a href={`/patents/${p.number}.pdf`} target="_blank" rel="noopener" aria-label={`查看${p.title}的完整 PDF`}>全文 PDF ↗</a></div>
        </div>
      </article>
    ))}

      <article class="certificate-card" id="copyright-document">
        <button type="button" class="certificate-preview" data-media={JSON.stringify([{ image: '/certificates/2025SR0789268.webp', caption: '输电线路覆冰类型检测系统 V1.0 · 2025SR0789268 · 软件著作权登记证书' }])} aria-label="查看输电线路覆冰类型检测系统的软件著作权登记证书" aria-haspopup="dialog">
          <img src="/certificates/2025SR0789268-thumb.webp" alt="输电线路覆冰类型检测系统 V1.0 软件著作权登记证书" width="640" height="640" loading="lazy" decoding="async" />
          <span class="certificate-zoom" aria-hidden="true">↗</span>
        </button>
        <div class="certificate-caption">
          <h4>2025SR0789268</h4>
          <p>输电线路覆冰类型检测系统 V1.0</p>
          <p class="patent-status">软件著作权 · 已登记</p>
          <div class="certificate-meta"><span>2025.05.15</span><a href="/certificates/2025SR0789268.pdf" target="_blank" rel="noopener" aria-label="查看输电线路覆冰类型检测系统软著证书 PDF">证书 PDF ↗</a></div>
        </div>
      </article>
  </div>
</section>

<style>
  .certificate-wall { margin: 0 0 56px; scroll-margin-top: 100px; }
  .certificate-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 20px; }
  .certificate-heading h3 { font-size: var(--t-body); font-weight: var(--bold); margin: 0; }
  .certificate-heading h3 span { font-size: var(--t-label); font-weight: var(--regular); color: var(--ink-faint); letter-spacing: 0.08em; text-transform: uppercase; margin-left: 12px; }
  .certificate-heading > p { color: var(--ink-faint); font-size: var(--t-label); margin: 0; }
  .certificate-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px 12px; }
  .certificate-card { min-width: 0; }
  .certificate-preview { display: flex; position: relative; align-items: center; justify-content: center; width: 100%; aspect-ratio: 1.65; padding: 6px; border: 1px solid var(--line); border-radius: 10px; background: #fff; cursor: zoom-in; transition: border-color .2s; }
  .certificate-preview img { display: block; width: 100%; height: 100%; object-fit: contain; transition: transform .2s; }
  .certificate-preview:hover { border-color: #a9b4c8; }
  .certificate-preview:hover img { transform: scale(1.025); }
  .certificate-zoom { position: absolute; bottom: 5px; right: 7px; color: var(--ink-faint); font-size: var(--t-label); }
  .certificate-caption { padding: 8px 1px 0; }
  .certificate-caption h4 { color: var(--ink); font-size: var(--t-small); font-weight: var(--bold); line-height: 1.5; margin: 0 0 3px; }
  .certificate-caption > p { color: var(--ink-soft); font-size: var(--t-label); line-height: 1.6; margin: 0; }
  .certificate-caption > .patent-status { margin-top: 5px; color: var(--ink-faint); font-size: var(--t-label); }
  .certificate-meta { display: flex; justify-content: space-between; align-items: baseline; margin-top: 5px; font-size: var(--t-label); color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .certificate-meta a { padding: 4px 0 4px 12px; color: var(--accent); text-decoration: none; }
  .certificate-meta a:hover { text-decoration: underline; }
  @media (min-width: 761px) and (max-width: 1100px) { .certificate-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .certificate-heading { display: block; }
    .certificate-heading > p { margin-top: 8px; }
    .certificate-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 12px; }
    .certificate-preview { aspect-ratio: 1.5; }
  }
  @media (prefers-reduced-motion: reduce) { .certificate-preview, .certificate-preview img { transition: none; } }
</style>
