---
import MediaFrame from './MediaFrame.astro';
import Icons from './Icons.astro';

/*
 * 项目条目：缩略媒体 + 信息。frontmatter 契约见 README。
 */

interface Stat {
  label: string;
  value: string;
}
interface Link {
  label: string;
  url: string;
  icon?: string;
}

interface Props {
  project: {
    id: string;
    title: string;
    titleEn?: string;
    group: string;
    role: string;
    org?: string;
    orgLogo?: string;
    brand?: string;
    date: string;
    brief: string;
    Content?: any;
    stats?: Stat[];
    tags?: string[];
    outcome?: string;
    outcomeLabel?: string;
    links?: Link[];
    image?: string;
    video?: string;
    media?: { video?: string; image?: string; caption?: string }[];
  };
  index?: number;
}

const { project: p, index } = Astro.props;
const { Content } = p;
const linkIcon = (l: Link) =>
  l.icon ?? (/github/i.test(l.url + l.label) ? 'github' : /huggingface/i.test(l.url) ? 'hf' : 'link');
const meta = [p.org, p.date].filter(Boolean);
const kind = p.media?.some((m) => m.video) || p.video ? 'is-video' : p.media?.length || p.image ? 'is-image' : '';
---

<article class={`proj reveal ${kind}`} id={p.id}>
  <MediaFrame title={p.title} titleEn={p.titleEn} image={p.image} video={p.video} media={p.media} index={index} />

  <div class="proj-body">
    <div class="proj-meta">
      <span class="role">{p.role}</span>
      {p.orgLogo && p.brand && <span class="brand-chip"><img src={p.orgLogo} alt="" />{p.brand}</span>}
      {meta.map((m) => <span>{m}</span>)}
    </div>

    <h4 class="proj-title">{p.title}</h4>
    {p.titleEn && <p class="proj-en">{p.titleEn}</p>}
    <p class="proj-brief">{p.brief}</p>

    {p.stats && p.stats.length > 0 && (
      <div class="stats">
        {p.stats.map((s) => (
          <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>
        ))}
      </div>
    )}

    {p.outcome && (
      <p class="outcome"><span class="outcome-label">{p.outcomeLabel ?? '成果'}</span>{p.outcome}</p>
    )}

    {p.tags && p.tags.length > 0 && (
      <p class="tags">{p.tags.map((t) => <span>{t}</span>)}</p>
    )}

    {p.links && p.links.length > 0 && (
      <div class="links">
        {p.links.map((l) => (
          <a href={l.url} target="_blank" rel="noopener noreferrer">
            <Icons name={linkIcon(l)} size={13} />{l.label}
          </a>
        ))}
      </div>
    )}

    {Content && (
      <details class="more">
        <summary>展开详情</summary>
        <div class="more-body"><Content /></div>
      </details>
    )}
  </div>
</article>
