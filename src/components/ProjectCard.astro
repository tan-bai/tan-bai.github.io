---
import MediaFrame from './MediaFrame.astro';
import Icons from './Icons.astro';

/*
 * 项目条目：媒体 + 信息双栏
 * frontmatter 契约见 src/content/projects/ 任一文件头部注释。
 */

interface Stat {
  label: string;
  value: string;
}
interface Link {
  label: string;
  url: string;
  icon?: string;
}

interface Props {
  project: {
    id: string;
    title: string;
    titleEn?: string;
    group: string;
    role: string;
    org?: string;
    date: string;
    brief: string;
    Content?: any; // Markdown 正文组件，渲染在「展开详情」里
    stats?: Stat[];
    tags?: string[];
    outcome?: string;
    outcomeLabel?: string;
    links?: Link[];
    image?: string;
    video?: string;
    media?: { video?: string; image?: string; caption?: string }[];
    reverse?: boolean;
  };
  index: number;
}

const { project: p, index } = Astro.props;
const { Content } = p;
const linkIcon = (l: Link) => l.icon ?? (/github/i.test(l.url + l.label) ? 'github' : /huggingface/i.test(l.url) ? 'hf' : 'link');
---

<article class:list={['project', 'reveal', { reverse: p.reverse }]}>
  <div class="project-media">
    <MediaFrame title={p.title} group={p.group} image={p.image} video={p.video} media={p.media} />
  </div>

  <div class="project-body">
    <div class="overline">
      <span class="no">{String(index).padStart(2, '0')}</span>
      <span class="role">{p.role}</span>
      {p.org && <span>{p.org}</span>}
      <span>{p.date}</span>
    </div>

    <h3>
      {p.title}
      {p.titleEn && <span class="en">{p.titleEn}</span>}
    </h3>

    <p class="project-brief">{p.brief}</p>

    {p.stats && p.stats.length > 0 && (
      <div class="stat-chips">
        {p.stats.map((s) => (
          <span class="chip"><b>{s.value}</b>{s.label}</span>
        ))}
      </div>
    )}

    {p.tags && p.tags.length > 0 && (
      <div class="tags">
        {p.tags.map((t) => (
          <span>{t}</span>
        ))}
      </div>
    )}

    {p.outcome && (
      <div class="outcome">
        <b>{p.outcomeLabel ?? '成果'}</b> — {p.outcome}
      </div>
    )}

    {p.links && p.links.length > 0 && (
      <div class="project-links">
        {p.links.map((l) => (
          <a href={l.url} target="_blank" rel="noopener noreferrer">
            <Icons name={linkIcon(l)} size={14} />
            {l.label}
          </a>
        ))}
      </div>
    )}

    {Content && (
      <details class="more">
        <summary>展开详情</summary>
        <div class="more-body">
          <Content />
        </div>
      </details>
    )}
  </div>
</article>
