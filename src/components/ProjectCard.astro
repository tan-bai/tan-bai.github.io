---
import MediaFrame from './MediaFrame.astro';

interface Stat {
  label: string;
  value: string;
}
interface Link {
  label: string;
  url: string;
}

interface Props {
  project: {
    id: string;
    title: string;
    titleEn?: string;
    group: string;
    role: string;
    org?: string;
    date: string;
    brief: string;
    Content?: any; // Markdown 正文，渲染在「展开详情」
    stats?: Stat[];
    tags?: string[];
    outcome?: string;
    outcomeLabel?: string;
    links?: Link[];
    image?: string;
    video?: string;
    reverse?: boolean;
  };
}

const { project: p } = Astro.props;
const { Content } = p;
const overline = [p.role, p.org, p.date].filter(Boolean);
---

<article class:list={['project', 'reveal', { reverse: p.reverse }]}>
  <div class="project-media">
    <MediaFrame title={p.title} group={p.group} image={p.image} video={p.video} />
  </div>

  <div class="project-body">
    <div class="overline">
      {overline.map((part, i) => (
        <>
          {i > 0 && <span class="sep">/</span>}
          {i === 0 ? <span class="role">{part}</span> : part}
        </>
      ))}
    </div>

    <h3>
      {p.title}
      {p.titleEn && <span class="en">{p.titleEn}</span>}
    </h3>

    <p class="project-brief">{p.brief}</p>

    {p.stats && p.stats.length > 0 && (
      <div class="figures">
        {p.stats.map((s, i) => (
          <>
            {i > 0 && <span class="sep">·</span>}
            <span><b>{s.value}</b>{s.label}</span>
          </>
        ))}
      </div>
    )}

    {p.tags && p.tags.length > 0 && (
      <div class="tags">{p.tags.join('　')}</div>
    )}

    {p.outcome && (
      <div class="outcome">
        <span class="label">{p.outcomeLabel ?? '成果'}</span>{p.outcome}
      </div>
    )}

    {p.links && p.links.length > 0 && (
      <div class="project-links">
        {p.links.map((l) => (
          <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
        ))}
      </div>
    )}

    {Content && (
      <details class="more">
        <summary>展开详情</summary>
        <div class="more-body">
          <Content />
        </div>
      </details>
    )}
  </div>
</article>
