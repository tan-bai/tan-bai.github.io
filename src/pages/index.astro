---
import Base from '../layouts/Base.astro';
import Project from '../components/Project.astro';
import { profile, pillars, lineage, timeline, honors, awards, patents } from '../data/site';

const nav = [
  { href: '#work', label: 'Work' },
  { href: '#path', label: 'Path' },
  { href: '#recognition', label: 'Recognition' },
  { href: '#contact', label: 'Contact' },
];
---

<Base>
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-name" href="#top">{profile.name}</a>
      <div class="nav-links">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </div>
    </div>
  </nav>

  <main class="page">
    <!-- ============================ Hero ============================ -->
    <header class="hero" id="top">
      <div class="hero-text">
        <p class="status"><span class="status-dot" aria-hidden="true"></span>{profile.status}</p>
        <h1>{profile.name}<span lang="zh-CN">{profile.nameZh}</span></h1>
        <p class="headline">{profile.headline}</p>
        <p class="bio">{profile.bio}</p>
        <ul class="edu">
          {profile.education.map((e) => (
            <li><b>{e.school}</b><span>{e.detail}</span><span class="edu-date">{e.date}</span></li>
          ))}
        </ul>
        <p class="hero-links">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub<span aria-hidden="true">↗</span></a>
          <a href={profile.blog} target="_blank" rel="noopener noreferrer">Blog<span aria-hidden="true">↗</span></a>
        </p>
      </div>
      <figure class="hero-photo">
        <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="295" height="399" fetchpriority="high" />
      </figure>

      <ol class="arc" aria-label="Path so far">
        {timeline.map((s) => (
          <li><a href="#path"><span class="arc-no">{s.no}</span>{s.name}</a></li>
        ))}
      </ol>
    </header>

    <!-- ============================ Work ============================ -->
    <section class="section" id="work" data-spy>
      <header class="section-head">
        <h2>Selected work</h2>
        <p>Ordered by impact. Click any image or video to enlarge.</p>
      </header>

      {pillars.map((pl) => (
        <section class="pillar" id={pl.id} aria-labelledby={`${pl.id}-h`}>
          <header class="pillar-head reveal">
            <span class="pillar-no">{pl.no}</span>
            <h3 id={`${pl.id}-h`}>{pl.name}</h3>
            <p>{pl.thesis}</p>
          </header>

          {pl.id === 'vision' && (
            <ol class="lineage reveal" aria-label="Detection architectures worked through">
              {lineage.map((l) => (
                <li><b>{l.name}</b><span>{l.note}</span></li>
              ))}
            </ol>
          )}

          {pl.feature && <Project project={pl.feature} variant="feature" />}

          <div class={pl.layout === 'compact' ? 'grid grid--compact' : pl.projects.length % 2 === 0 ? 'grid grid--even' : 'grid'}>
            {pl.projects.map((p) => (
              <Project project={p} variant={pl.layout === 'compact' ? 'compact' : 'card'} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ============================ Path ============================ -->
    <section class="section" id="path" data-spy>
      <header class="section-head">
        <h2>Path</h2>
        <p>How the work moved: from circuits to perception, to robots, to agents. Stages overlap in time.</p>
      </header>

      <ol class="timeline">
        {timeline.map((s) => (
          <li class="stage reveal">
            <div class="stage-head">
              <span class="stage-no">{s.no}</span>
              <h3>{s.name}</h3>
              <span class="stage-span">{s.span}</span>
              <p>{s.line}</p>
            </div>
            <ul class="rows">
              {s.items.map((m) => (
                <li>
                  <span class="row-date">{m.date}</span>
                  <div>
                    {m.href ? <a class="row-title" href={m.href}>{m.title}</a> : <span class="row-title">{m.title}</span>}
                    {m.detail && <p class="row-detail">{m.detail}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <!-- ========================= Recognition ======================== -->
    <section class="section" id="recognition" data-spy>
      <header class="section-head">
        <h2>Recognition</h2>
      </header>

      <div class="recog reveal">
        <div>
          <h3>Honors</h3>
          <ul class="rows rows--tight">
            {honors.map((h) => (
              <li><span class="row-date">{h.date}</span><span class="row-title">{h.name}</span></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Selected competitions</h3>
          <ul class="rows rows--tight">
            {awards.map((a) => (
              <li><span class="row-date">{a.date}</span><div><span class="row-title">{a.name}</span><p class="row-detail">{a.result}</p></div></li>
            ))}
          </ul>
        </div>
        <div class="recog-wide">
          <h3>Patent applications</h3>
          <ul class="rows rows--tight">
            {patents.map((p) => (
              <li><span class="row-date mono">{p.id}</span><span class="row-title">{p.name}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- =========================== Contact ========================== -->
    <section class="section contact" id="contact" data-spy>
      <h2>Let’s build something that runs on real hardware.</h2>
      <p>
        I’m looking for research and engineering internships in embodied AI, robot learning and agent systems.
        The fastest way to reach me is email.
      </p>
      <p class="contact-links">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub<span aria-hidden="true">↗</span></a>
      </p>
    </section>

    <footer class="footer">
      <span>© 2026 {profile.name}</span>
      <span>Updated October 2026</span>
    </footer>
  </main>
</Base>
