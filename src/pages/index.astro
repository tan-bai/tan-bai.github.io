---
import Base from '../layouts/Base.astro';
import CertificateWall from '../components/CertificateWall.astro';
import ProjectCard from '../components/ProjectCard.astro';
import OsRow from '../components/OsRow.astro';
import Icons from '../components/Icons.astro';
import { posterOf } from '../lib/media';

/* ---------- 数据装载：src/content/projects/*.md ---------- */
const mods = import.meta.glob<{ frontmatter: any; Content: any }>('../content/projects/*.md', {
  eager: true,
});
const all = Object.entries(mods).map(([path, m]) => ({
  ...m.frontmatter,
  id: path.split('/').pop()!.replace(/\.md$/, ''),
  Content: m.Content,
}));
const byId = Object.fromEntries(all.map((p) => [p.id, p]));

/* ---------- 个人信息（首屏） ---------- */
const profile = {
  name: '房家辉',
  en: 'Jiahui Fang',
  status: '欢迎实习、全职与科研合作机会',
  school: '东南大学',
  program: '电子信息 · 研究生',
  bio: '<strong>具身智能</strong>方面，关注无人机空中视觉语言导航（Aerial VLN）、视觉-语言-动作模型（VLA）与面向无人机的世界模型；<strong>AI for AI</strong> 方面，研究并构建能够自动化科学研究的大模型 Agent。',
  path: '我从<strong>视觉感知</strong>起步——红外小目标、无人机覆冰与航拍小目标检测，技术栈从 YOLO 系列走到 DETR / D-FINE；随后转向<strong>具身智能</strong>：先在仿真中训练宇树人形机器人，再在暑期学校上手 G1 真机；之后在浙江大学 FAST-LAB 参与轮足机器人羽毛球项目，负责动捕数据处理；最近在智元机器人实习期间独立负责项目，打通了从视频生成、动作提取、重定向、RL 策略训练到真机部署的完整链路。',
  email: 'jiahui.fang@ieee.org',
  github: 'https://github.com/20bytes',
  site: 'https://20bytes.top',
};

const facts = [
  { value: '4', unit: '项', label: '发明专利 · 实审中' },
  { value: '12', unit: '项', label: '竞赛与项目荣誉' },
  { value: '15.5', unit: '万', label: 'Polaris 收录顶会论文' },
  { value: '787', unit: '', label: 'GitHub 贡献 · 2026.3 起' },
];

/* ---------- 经历（链接到对应项目） ---------- */
const experience = [
  { period: '2026.7 – 2026.8', org: '智元机器人 · 上海', desc: '人形机器人 X2 的 RL 策略训练与真机部署', role: '算法实习', href: '#x2-internship' },
  { period: '2025.8 – 2026.1', org: '浙江大学 FAST-LAB', desc: '羽毛球轮足机器人：动捕数据处理与轨迹分析', role: '科研实习', href: '#badminton-robot' },
  { period: '2025.7', org: 'ROS 暑期学校 · 宇树科技 × 深蓝学院', desc: 'Unitree G1 人形机器人全栈开发训练营', role: '学员', href: '#ros-g1' },
  { period: '2024.8 – 2024.9', org: 'SHNU 机器人与智能制造实验室', desc: '双足机器人强化学习仿真训练', role: '进组学习', href: '#bipedal' },
];

/* ---------- 精选：首屏下方的三个代表作 ---------- */
const featured = [
  { id: 'x2-internship', kicker: 'HUMANOID · RL', desc: '从人体视频到真机行走：骨骼提取、动作重定向、策略训练与部署诊断。' },
  { id: 'pi0-vla', kicker: 'VLA · REPRODUCTION', desc: '独立复现 π0 流匹配动作生成，LIBERO 评测 10 回合 9 成功。' },
  { id: 'proma', kicker: 'AGENT · AI SCIENTIST', desc: '基于 Qwen 的自动化研究 Agent 平台，挑战杯揭榜挂帅阿里云榜题作品。' },
];
const featMedia = (p: any) => p.media?.[0] ?? { video: p.video, image: p.image };

/* ---------- 项目分组 ---------- */
const groups = [
  {
    id: 'g-embodied',
    toc: '机器人',
    name: '具身智能与机器人',
    sub: 'Embodied AI & Robotics',
    desc: '从仿真到真机：宇树人形仿真 → G1 真机实践 → FAST-LAB 轮足机器人羽毛球 → 智元 X2 端到端人形链路与真机部署。',
    ids: ['x2-internship', 'badminton-robot', 'ros-g1', 'bipedal'],
  },
  {
    id: 'g-llm',
    toc: 'VLA / LLM',
    name: '大模型与 VLA 复现',
    sub: 'LLM & VLA',
    desc: '从论文到代码：π0 视觉-语言-动作模型家族复现，Stanford CS336 从零构建语言模型。',
    ids: ['pi0-vla', 'cs336'],
  },
  {
    id: 'g-agent',
    toc: 'Agent',
    name: 'Agent 开发',
    sub: 'Agent Systems',
    desc: '两项竞赛中的 Agent 实践：挑战杯揭榜挂帅阿里云榜题的 AI Scientist 平台 Proma，与字节跳动 AI 全栈挑战赛的深度研究 Agent 明镜。',
    ids: ['proma', 'bytedance'],
  },
  {
    id: 'g-vision',
    toc: '视觉',
    name: '视觉感知',
    sub: 'Visual Perception',
    desc: '我的起点：红外小目标、无人机覆冰与航拍小目标检测；技术栈从 YOLOv5 / v8 / v11 演进到 DETR 与 D-FINE。',
    ids: ['lcga-net', 'safe-detr', 'powerline-icing'],
  },
  {
    id: 'g-hardware',
    toc: '其他',
    name: '其他项目',
    sub: 'Hardware, Embedded & Competitions',
    desc: '电子信息专业背景下的硬件、嵌入式与竞赛项目，作为主线之外的工程补充。',
    ids: ['study-lamp', 'signal-system', 'smart-car', 'tw-msd', 'parking-nav', 'accessibility-aid', 'lanqiao'],
    layout: 'grid',
  },
];
const osIds = ['beatless', 'polaris', 'aerial-vln'];

/* ---------- 荣誉 / 竞赛 / 专利 ---------- */
const honors = [
  { name: '国家奖学金', note: '教育部' },
  { name: '上海市奖学金', note: '上海市教育委员会' },
  { name: '上海市优秀毕业生', note: '上海市教育委员会' },
];
const competitions = [
  { name: '上海市级大学生创新创业训练计划', result: '优秀结项', role: '第一完成人', date: '2025.11' },
  { name: '中国机器人与人工智能大赛省级选拔赛', result: '省级三等奖', role: '第一完成人', date: '2025.08' },
  { name: '中国国际大学生创新大赛（2025）上海赛区', result: '铜奖', role: '', date: '2025.08' },
  { name: '上海市大学生计算机应用能力大赛', result: '省级二等奖', role: '第一完成人', date: '2025.06' },
  { name: '「挑战杯」上海市大学生课外学术科技作品竞赛', result: '省级一等奖', role: '第一完成人', date: '2025.05' },
  { name: '上海市大学生创造杯大赛', result: '省级三等奖', role: '', date: '2024.11' },
  { name: '全国大学生物联网设计竞赛（华为杯）', result: '全国二等奖', role: '第一完成人', date: '2024.08' },
  { name: '全国大学生集成电路创新创业大赛华东赛区', result: '省级二等奖', role: '第二完成人', date: '2024.07' },
  { name: '全国大学生金相技能大赛复赛（上海赛区）', result: '省级三等奖', role: '', date: '2024.05' },
  { name: '蓝桥杯全国软件和信息技术专业人才大赛上海赛区', result: '省级三等奖', role: '', date: '2024.04' },
  { name: '全国大学生物联网设计竞赛（华为杯）华东赛区', result: '赛区一等奖', role: '第一完成人', date: '2023.08' },
  { name: '全国大学生节能减排社会实践与科技竞赛', result: '全国三等奖', role: '第二完成人', date: '2023.08' },
];
const patents = [
  { kind: '发明专利', name: '一种基于增强型对抗运动先验的双足机器人步态生成方法', no: 'CN120595629A · 实审' },
  { kind: '发明专利', name: '一种基于改进 YOLOv7 的门框识别方法', no: 'CN120726591A · 实审' },
  { kind: '发明专利', name: '一种基于位姿优化网络的 6-DoF 目标位姿估计方法', no: 'CN120747212A · 实审' },
  { kind: '发明专利', name: '基于多模态深度学习的帕金森病患智能辅助进食系统', no: 'CN120748020A · 实审' },
  { kind: '实用新型', name: '一种带有热交换通风孔的摄像头加热防护罩', no: '2025204530867 · 已受理' },
  { kind: '软件著作权', name: '输电线路覆冰类型检测系统', no: '2025SR0789268 · 已授权' },
];

const navItems = [
  { href: '#experience', label: '经历' },
  { href: '#projects', label: '项目' },
  { href: '#opensource', label: '开源' },
  { href: '#honors', label: '荣誉' },
  { href: '#contact', label: '联系' },
];
---

<Base>
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-logo" href="#top">{profile.name}<span>{profile.en}</span></a>
      <div class="nav-links">
        {navItems.map((n) => <a href={n.href}>{n.label}</a>)}
      </div>
    </div>
  </nav>

  <!-- ================= 首屏 ================= -->
  <header class="intro" id="top">
    <div class="wrap">
      <div class="intro-grid">
        <div class="intro-copy">
          <div class="intro-head">
            <p class="intro-status"><span class="dot" aria-hidden="true"></span>{profile.status}</p>
            <h1>{profile.name}</h1>
            <p class="intro-id"><span class="en">{profile.en}</span><span class="intro-sep" aria-hidden="true"></span><span class="intro-affil">{profile.school} · {profile.program}</span></p>
          </div>

          <p class="intro-lead">我的研究横跨两个方向：<em>具身智能</em>与 <em>AI for AI</em>。</p>
          <p class="intro-bio" set:html={profile.bio} />
          <p class="intro-bio" set:html={profile.path} />

          <div class="intro-actions">
            <a class="btn" href={`mailto:${profile.email}`}><Icons name="mail" />{profile.email}</a>
            <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer"><Icons name="github" />GitHub</a>
            <a class="btn" href={profile.site} target="_blank" rel="noopener noreferrer"><Icons name="globe" />博客</a>
          </div>
        </div>

        <aside class="intro-side">
          <figure class="portrait">
            <img src="/media/profile-photo.png" alt={`${profile.name}的照片`} width="295" height="399" fetchpriority="high" />
          </figure>
        </aside>
      </div>

      <div class="facts">
        {facts.map((f) => (
          <div class="fact">
            <div class="fact-value">{f.value}{f.unit && <small>{f.unit}</small>}</div>
            <div class="fact-label">{f.label}</div>
          </div>
        ))}
      </div>
    </div>
  </header>

  <!-- ================= 经历 ================= -->
  <section class="block" id="experience" data-spy>
    <div class="wrap sec">
      <header class="sec-head reveal">
        <span class="sec-no">i.</span>
        <h2 class="sec-title">经历</h2>
        <p class="sec-sub">Experience</p>
      </header>
      <ul class="sec-body reveal">
        {experience.map((e) => (
          <li class="exp-item">
            <span class="exp-period">{e.period}</span>
            <div>
              <div class="exp-org">{e.org}</div>
              <div class="exp-desc">{e.desc}</div>
            </div>
            <a class="exp-link" href={e.href}>{e.role} →</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= 项目 ================= -->
  <section class="block" id="projects" data-spy>
    <div class="wrap sec">
      <header class="sec-head reveal">
        <span class="sec-no">ii.</span>
        <h2 class="sec-title">项目</h2>
        <p class="sec-sub">Selected Work</p>
      </header>

      <div class="sec-body">
        <div class="featured reveal">
          {featured.map((f, i) => {
            const p = byId[f.id];
            if (!p) return null;
            const m = featMedia(p);
            return (
              <a class={i === 0 ? "feat feat-lead" : "feat"} href={`#${f.id}`}>
                <div class="feat-media">
                  {m.video ? (
                    <video src={m.video} poster={posterOf(m)} muted loop playsinline preload="none" data-autoplay />
                  ) : (
                    <img src={m.image} alt={p.title} loading="lazy" />
                  )}
                </div>
                <span class="feat-text">
                  <span class="feat-kicker">{f.kicker}</span>
                  <span class="feat-title">{p.title}</span>
                  <span class="feat-desc">{f.desc}</span>
                </span>
              </a>
            );
          })}
        </div>

        {groups.map((g) => {
          const list = g.ids.map((id) => byId[id]).filter(Boolean);
          return (
            <div class="proj-group" id={g.id}>
              <div class="proj-group-head reveal">
                <h3 class="proj-group-title">{g.name}</h3>
                <span class="proj-group-meta">{g.sub}</span>
                <span class="proj-group-count">{String(list.length).padStart(2, '0')}</span>
              </div>
              <p class="proj-group-desc reveal">{g.desc}</p>
              <div class={g.layout === 'grid' ? 'proj-grid' : undefined}>
                {list.map((p, i) => <ProjectCard project={p} index={i + 1} />)}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <nav class="toc" aria-label="项目分组">
    {groups.map((g) => <a href={`#${g.id}`}>{g.toc}</a>)}
  </nav>

  <!-- ================= 开源 ================= -->
  <section class="block" id="opensource" data-spy>
    <div class="wrap sec">
      <header class="sec-head reveal">
        <span class="sec-no">iii.</span>
        <h2 class="sec-title">开源</h2>
        <p class="sec-sub">Open Source</p>
      </header>
      <div class="sec-body">
        <ul>
          {osIds.map((id) => {
            const repo = byId[id];
            return repo ? <OsRow repo={repo} /> : null;
          })}
        </ul>
        <div class="activity reveal">
          <figure>
            <img src="/media/github-heatmap.svg" alt="GitHub 提交热力图" loading="lazy" />
            <figcaption>GitHub 活跃记录 · 2026.3 至今 · 787 次贡献 · 120 个活跃日</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 荣誉 ================= -->
  <section class="block" id="honors" data-spy>
    <div class="wrap sec">
      <header class="sec-head reveal">
        <span class="sec-no">iv.</span>
        <h2 class="sec-title">荣誉</h2>
        <p class="sec-sub">Honors &amp; Patents</p>
      </header>
      <div class="sec-body">
        <div class="honors reveal">
          {honors.map((h) => (
            <div class="honor">
              <div class="honor-name">{h.name}</div>
              <div class="honor-note">{h.note}</div>
            </div>
          ))}
        </div>

        <h3 class="sub-title reveal">竞赛</h3>
        <ul class="row-list reveal">
          {competitions.map((c) => (
            <li>
              <span class="row-date">{c.date}</span>
              <span class="row-main">{c.name}{c.role && <small>{c.role}</small>}</span>
              <strong class="row-side">{c.result}</strong>
            </li>
          ))}
        </ul>

        <CertificateWall />

        <h3 class="sub-title reveal">专利与软件著作权</h3>
        <ul class="row-list reveal">
          {patents.map((p) => (
            <li>
              <span class="row-kind">{p.kind}</span>
              <span class="row-main">{p.name}</span>
              <span class="row-no">{p.no}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= 联系 ================= -->
  <section class="contact" id="contact" data-spy>
    <div class="wrap">
      <div class="contact-inner">
        <h2 class="contact-title reveal">一起把机器人<em>带进真实世界</em>。</h2>
        <p class="contact-text reveal">正在寻找具身智能、机器人学习方向的实习与工作机会，也欢迎科研合作与交流。</p>
        <div class="intro-actions reveal">
          <a class="btn" href={`mailto:${profile.email}`}><Icons name="mail" />{profile.email}</a>
          <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer"><Icons name="github" />GitHub</a>
          <a class="btn" href={profile.site} target="_blank" rel="noopener noreferrer"><Icons name="globe" />博客</a>
        </div>
      </div>
      <footer class="footer">
        <span>© 2026 房家辉 Jiahui Fang</span>
        <span class="colophon">更新于 2026 年 10 月</span>
      </footer>
    </div>
  </section>
</Base>
