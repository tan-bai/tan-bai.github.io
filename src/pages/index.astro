---
import Base from '../layouts/Base.astro';
import CertificateWall from '../components/CertificateWall.astro';
import ProjectCard from '../components/ProjectCard.astro';
import OsRow from '../components/OsRow.astro';

/* ---------- 数据装载：src/content/projects/*.md ---------- */
const mods = import.meta.glob<{ frontmatter: any; Content: any }>('../content/projects/*.md', {
  eager: true,
});
const all = Object.entries(mods).map(([path, m]) => ({
  ...m.frontmatter,
  id: path.split('/').pop()!.replace(/\.md$/, ''),
  Content: m.Content,
}));
const byId = Object.fromEntries(all.map((p) => [p.id, p]));

/* ---------- 个人信息 ---------- */
const profile = {
  name: '房家辉',
  en: 'Jiahui Fang',
  affil: '东南大学 · 电子信息 · 硕士研究生',
  status: '欢迎实习、全职与科研合作机会',
  bio: [
    '我的研究横跨两个方向：<b>具身智能</b>——无人机空中视觉语言导航（Aerial VLN）、视觉-语言-动作模型（VLA）与面向无人机的世界模型；以及 <b class="nb">AI for AI</b>——研究并构建能够自动化科学研究的大模型 Agent。',
    '此前，我在智元 X2 人形机器人上打通了从人体视频到真机部署的强化学习链路，并在浙江大学 FAST-LAB 参与羽毛球轮足机器人的感知研究。',
  ],
  email: 'jiahui.fang@ieee.org',
  github: 'https://github.com/20bytes',
  site: 'https://20bytes.top',
};

/* ---------- 动态（新的放最前） ---------- */
const news = [
  { date: '2026.09', text: '进入东南大学攻读电子信息硕士（推免）。' },
  { date: '2026.07', text: '开始人形机器人算法实习：在智元 X2 上训练并部署 RL 策略。' },
  { date: '2026.05', text: '获评上海市优秀毕业生。' },
  { date: '2025.12', text: '获<b>国家奖学金</b>。' },
  { date: '2025.05', text: '「挑战杯」上海市大学生课外学术科技作品竞赛省级一等奖（第一完成人）。' },
];

/* ---------- 经历（链接到对应项目） ---------- */
const experience = [
  { period: '2026.7 – 2026.8', org: '智元机器人 · 上海', desc: '人形机器人 X2 的 RL 策略训练与真机部署', role: '算法实习', href: '#x2-internship' },
  { period: '2025.8 – 2026.1', org: '浙江大学 FAST-LAB', desc: '羽毛球轮足机器人：多传感感知与来球轨迹预测', role: '科研实习', href: '#badminton-robot' },
  { period: '2025.7', org: 'ROS 暑期学校 · 宇树科技 × 深蓝学院', desc: 'Unitree G1 人形机器人全栈开发训练营', role: '学员', href: '#ros-g1' },
  { period: '2024.8 – 2024.9', org: 'SHNU 机器人与智能制造实验室', desc: '双足机器人强化学习仿真训练', role: '进组学习', href: '#bipedal' },
];

/* ---------- 代表性工作：在项目列表中高亮 ---------- */
const highlight = ['x2-internship', 'pi0-vla', 'proma'];

/* ---------- 项目分组 ---------- */
const groups = [
  {
    id: 'g-llm',
    toc: 'VLA / LLM',
    name: '大模型与 VLA 复现',
    sub: 'LLM & VLA',
    desc: '从论文到代码：π0 视觉-语言-动作模型家族复现，Stanford CS336 从零构建语言模型。',
    ids: ['pi0-vla', 'cs336'],
  },
  {
    id: 'g-agent',
    toc: 'Agent',
    name: 'Agent 开发',
    sub: 'Agent Systems',
    desc: '两项竞赛中的 Agent 实践：挑战杯揭榜挂帅阿里云榜题的 AI Scientist 平台 Proma，与字节跳动 AI 全栈挑战赛的深度研究 Agent 明镜。',
    ids: ['proma', 'bytedance'],
  },
  {
    id: 'g-embodied',
    toc: '机器人',
    name: '具身智能与机器人',
    sub: 'Embodied AI & Robotics',
    desc: '从仿真到真机本体：智元 X2 人形机器人策略训练、宇树 G1 全栈开发、FAST-LAB 羽毛球轮足机器人感知、双足仿真训练。',
    ids: ['x2-internship', 'badminton-robot', 'ros-g1', 'bipedal'],
  },
  {
    id: 'g-vision',
    toc: '视觉',
    name: '计算机视觉',
    sub: 'Computer Vision',
    desc: '围绕小目标检测的两条路线：红外小目标的曲率先验设计，与无人机航拍的轻量化端到端框架。',
    ids: ['lcga-net', 'safe-detr'],
  },
  {
    id: 'g-edge',
    toc: '端云',
    name: '端云协同与智能感知',
    sub: 'Edge–Cloud Sensing',
    desc: '把视觉模型放进端侧设备，再让云端大模型完成分析决策。',
    ids: ['powerline-icing', 'study-lamp'],
  },
  {
    id: 'g-hardware',
    toc: '硬件',
    name: '硬件与电子设计',
    sub: 'Electronics & Hardware',
    desc: '本科阶段的动手基础：电赛信号系统、循迹小车、FPGA 数字设计、停车场导航、无障碍辅助与蓝桥杯。',
    ids: ['signal-system', 'smart-car', 'tw-msd', 'parking-nav', 'accessibility-aid', 'lanqiao'],
    layout: 'grid',
  },
];
const osIds = ['beatless', 'polaris', 'aerial-vln'];

/* ---------- 荣誉 / 竞赛 / 专利 ---------- */
const honors = [
  { name: '上海市优秀毕业生', note: '上海市教育委员会', date: '2026.05' },
  { name: '国家奖学金', note: '教育部', date: '2025.12' },
  { name: '上海市奖学金', note: '上海市教育委员会', date: '2025.12' },
];
const competitions = [
  { name: '上海市级大学生创新创业训练计划', result: '优秀结项', role: '第一完成人', date: '2025.11' },
  { name: '中国机器人与人工智能大赛省级选拔赛', result: '省级三等奖', role: '第一完成人', date: '2025.08' },
  { name: '中国国际大学生创新大赛（2025）上海赛区', result: '铜奖', role: '', date: '2025.08' },
  { name: '上海市大学生计算机应用能力大赛', result: '省级二等奖', role: '第一完成人', date: '2025.06' },
  { name: '「挑战杯」上海市大学生课外学术科技作品竞赛', result: '省级一等奖', role: '第一完成人', date: '2025.05' },
  { name: '上海市大学生创造杯大赛', result: '省级三等奖', role: '', date: '2024.11' },
  { name: '全国大学生物联网设计竞赛（华为杯）', result: '全国二等奖', role: '第一完成人', date: '2024.08' },
  { name: '全国大学生集成电路创新创业大赛华东赛区', result: '省级二等奖', role: '第二完成人', date: '2024.07' },
  { name: '全国大学生金相技能大赛复赛（上海赛区）', result: '省级三等奖', role: '', date: '2024.05' },
  { name: '蓝桥杯全国软件和信息技术专业人才大赛上海赛区', result: '省级三等奖', role: '', date: '2024.04' },
  { name: '全国大学生物联网设计竞赛（华为杯）华东赛区', result: '赛区一等奖', role: '第一完成人', date: '2023.08' },
  { name: '全国大学生节能减排社会实践与科技竞赛', result: '全国三等奖', role: '第二完成人', date: '2023.08' },
];
const patents = [
  { kind: '发明专利', name: '一种基于增强型对抗运动先验的双足机器人步态生成方法', no: 'CN120595629A · 实审' },
  { kind: '发明专利', name: '一种基于改进 YOLOv7 的门框识别方法', no: 'CN120726591A · 实审' },
  { kind: '发明专利', name: '一种基于位姿优化网络的 6-DoF 目标位姿估计方法', no: 'CN120747212A · 实审' },
  { kind: '发明专利', name: '基于多模态深度学习的帕金森病患智能辅助进食系统', no: 'CN120748020A · 实审' },
  { kind: '实用新型', name: '一种带有热交换通风孔的摄像头加热防护罩', no: '2025204530867 · 已受理' },
  { kind: '软件著作权', name: '输电线路覆冰类型检测系统', no: '2025SR0789268 · 已授权' },
];

const navItems = [
  { href: '#experience', label: '经历' },
  { href: '#projects', label: '项目' },
  { href: '#opensource', label: '开源' },
  { href: '#honors', label: '荣誉' },
  { href: '#contact', label: '联系' },
];
---

<Base>
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-logo" href="#top">{profile.name}</a>
      <div class="nav-links">
        {navItems.map((n) => <a href={n.href}>{n.label}</a>)}
      </div>
    </div>
  </nav>

  <main class="page">
    <!-- ================= 个人信息 ================= -->
    <header class="hero" id="top">
      <div class="hero-text">
        <h1>{profile.name}<span class="en">{profile.en}</span></h1>
        <p class="affil">{profile.affil}</p>
        <div class="bio">
          {profile.bio.map((t) => <p set:html={t} />)}
        </div>
        <p class="hero-links">
          <a href={`mailto:${profile.email}`}>Email</a><span>/</span>
          <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a><span>/</span>
          <a href={profile.site} target="_blank" rel="noopener noreferrer">博客</a>
        </p>
        <p class="status"><span class="dot" aria-hidden="true"></span>{profile.status}</p>
      </div>
      <div class="hero-photo">
        <img src="/media/profile-photo.png" alt={`${profile.name}的照片`} width="295" height="399" fetchpriority="high" />
      </div>
    </header>

    <!-- ================= 动态 ================= -->
    <section class="sec" id="news">
      <h2>动态</h2>
      <ul class="news">
        {news.map((n) => (
          <li><span class="date">{n.date}</span><span set:html={n.text} /></li>
        ))}
      </ul>
    </section>

    <!-- ================= 经历 ================= -->
    <section class="sec" id="experience" data-spy>
      <h2>经历</h2>
      <ul class="rows">
        {experience.map((e) => (
          <li>
            <span class="date">{e.period}</span>
            <div>
              <a class="row-title" href={e.href}>{e.org}</a><span class="row-role">{e.role}</span>
              <p class="row-desc">{e.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- ================= 项目 ================= -->
    <section class="sec" id="projects" data-spy>
      <h2>项目</h2>
      <p class="sec-note">高亮条目为代表性工作；点击图片或视频可放大查看。</p>
      {groups.map((g) => {
        const list = g.ids.map((id) => byId[id]).filter(Boolean);
        return (
          <div class="proj-group" id={g.id}>
            <h3>{g.name}</h3>
            <p class="group-desc">{g.desc}</p>
            <div class={g.layout === 'grid' ? 'proj-grid' : 'proj-list'}>
              {list.map((p, i) => <ProjectCard project={p} index={i + 1} highlight={highlight.includes(p.id)} />)}
            </div>
          </div>
        );
      })}
    </section>

    <!-- ================= 开源 ================= -->
    <section class="sec" id="opensource" data-spy>
      <h2>开源</h2>
      <ul>
        {osIds.map((id) => {
          const repo = byId[id];
          return repo ? <OsRow repo={repo} /> : null;
        })}
      </ul>
      <figure class="activity">
        <img src="/media/github-heatmap.svg" alt="GitHub 提交热力图" loading="lazy" />
        <figcaption>GitHub 活跃记录 · 2026.3 至今 · 787 次贡献</figcaption>
      </figure>
    </section>

    <!-- ================= 荣誉 ================= -->
    <section class="sec" id="honors" data-spy>
      <h2>荣誉</h2>
      <ul class="plain">
        {honors.map((h) => (
          <li><span class="date">{h.date}</span><span><b>{h.name}</b><span class="muted"> · {h.note}</span></span></li>
        ))}
      </ul>

      <h3>竞赛</h3>
      <ul class="plain">
        {competitions.map((c) => (
          <li><span class="date">{c.date}</span><span>{c.name}，<b>{c.result}</b>{c.role && <span class="muted">（{c.role}）</span>}</span></li>
        ))}
      </ul>

      <CertificateWall />

      <h3>专利与软件著作权</h3>
      <ul class="plain">
        {patents.map((p) => (
          <li><span class="date">{p.kind}</span><span>{p.name}<span class="muted"> · {p.no}</span></span></li>
        ))}
      </ul>
    </section>

    <!-- ================= 联系 ================= -->
    <section class="sec" id="contact" data-spy>
      <h2>联系</h2>
      <p>正在寻找具身智能与 AI for AI 方向的实习、全职与科研合作机会。欢迎邮件联系：<a href={`mailto:${profile.email}`}>{profile.email}</a></p>
    </section>

    <footer class="footer">© 2026 房家辉 Jiahui Fang · 更新于 2026 年 10 月</footer>
  </main>
</Base>
