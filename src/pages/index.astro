---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import OsRow from '../components/OsRow.astro';

/* ---------- 数据装载：src/content/projects/*.md ---------- */
const mods = import.meta.glob<{ frontmatter: any; Content: any }>('../content/projects/*.md', {
  eager: true,
});
const all = Object.entries(mods).map(([path, m]) => ({
  ...m.frontmatter,
  id: path.split('/').pop()!.replace(/\.md$/, ''),
  Content: m.Content,
}));
const byId = Object.fromEntries(all.map((p) => [p.id, p]));

/* ---------- 章节编排 ---------- */
const groups = [
  {
    id: 'sensing',
    no: '一',
    name: '端云协同与智能感知',
    desc: '从智能台灯到电力巡检无人机：模型跑在端侧，分析交给云端。',
    ids: ['study-lamp', 'powerline-icing'],
  },
  {
    id: 'detection',
    no: '二',
    name: '目标检测与网络设计',
    desc: '红外与航拍两类小目标检测：一类面向成像特性设计先验，一类面向端上推理做轻量化。',
    ids: ['lcga-net', 'safe-detr'],
  },
  {
    id: 'embodied',
    no: '三',
    name: '具身智能与机器人',
    desc: '从仿真训练到真机调试：双足仿真、宇树 G1 训练营，以及 ZJU FAST-LAB 的轮足机器人感知。',
    ids: ['bipedal', 'ros-g1', 'badminton-robot'],
  },
  {
    id: 'llm',
    no: '四',
    name: '大模型与 VLA 复现',
    desc: '从论文到代码的复现：π0 视觉-语言-动作模型家族，以及 Stanford CS336 从零构建语言模型。',
    ids: ['pi0-vla', 'cs336'],
  },
];
const osIds = ['beatless', 'polaris', 'aerial-vln'];

/* ---------- 荣誉 / 竞赛 / 专利（源自简历模版三） ---------- */
const honors = ['国家奖学金', '上海市奖学金', '上海市优秀毕业生'];
const competitions = [
  { name: '上海市级大学生创新创业训练计划', note: '优秀结项 · 第一完成人', date: '2025.11' },
  { name: '全国大学生物联网设计竞赛（华为杯）', note: '全国二等奖 · 第一完成人', date: '2024.08' },
  { name: '「挑战杯」上海市大学生课外学术科技作品竞赛', note: '省级一等奖 · 第一完成人', date: '2025.05' },
  { name: '上海市大学生计算机应用能力大赛', note: '省级二等奖 · 第一完成人', date: '2025.06' },
  { name: '中国机器人与人工智能大赛省级选拔赛', note: '省级三等奖 · 第一完成人', date: '2025.08' },
  { name: '全国大学生节能减排社会实践与科技竞赛', note: '全国三等奖 · 第二完成人', date: '2023.08' },
  { name: '全国大学生集成电路创新创业大赛华东赛区', note: '省级二等奖 · 第二完成人', date: '2024.07' },
];
const patents = [
  { name: '一种基于增强型对抗运动先验的双足机器人步态生成方法', no: '发明专利 · CN120595629A · 实审' },
  { name: '一种基于改进 YOLOv7 的门框识别方法', no: '发明专利 · CN120726591A · 实审' },
  { name: '一种基于位姿优化网络的 6-DoF 目标位姿估计方法', no: '发明专利 · CN120747212A · 实审' },
  { name: '基于多模态深度学习的帕金森病患智能辅助进食系统', no: '发明专利 · CN120748020A · 实审' },
  { name: '一种带有热交换通风孔的摄像头加热防护罩', no: '实用新型 · 已受理' },
  { name: '输电线路覆冰类型检测系统', no: '软件著作权 · 已授权' },
];

const navItems = [
  ...groups.map((g) => ({ href: `#${g.id}`, label: g.name.slice(0, 4) })),
  { href: '#opensource', label: '开源' },
  { href: '#honors', label: '荣誉' },
];
---

<Base>
  <!-- ================= 导航 ================= -->
  <nav class="nav">
    <div class="wrap nav-inner">
      <a class="nav-brand" href="#top">房家辉</a>
      <div class="nav-links">
        {navItems.map((n) => <a href={n.href}>{n.label}</a>)}
      </div>
    </div>
  </nav>

  <!-- ================= Hero ================= -->
  <header class="hero" id="top">
    <div class="wrap">
      <h1>房家辉</h1>
      <p class="name-en">JIAHUI FANG</p>

      <p class="hero-tagline">
        视觉感知、具身智能与自动化科研——本科以来的项目存档，附图片与视频。
      </p>

      <p class="hero-meta">
        东南大学 自动化学院 硕士在读 · 上海师范大学 电子信息工程 学士<br />
        GPA 3.82 / 4.00（专业排名 1 / 425）
      </p>

      <div class="hero-links">
        <a href="mailto:jiahui.fang@ieee.org">jiahui.fang@ieee.org</a>
        <a href="https://github.com/20bytes" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://20bytes.top" target="_blank" rel="noopener noreferrer">20bytes.top</a>
      </div>

      <div class="stat-line reveal">
        <div class="cell"><b>九</b>个项目实践</div>
        <div class="cell"><b>三</b>套开源系统</div>
        <div class="cell"><b>七</b>项竞赛奖励</div>
        <div class="cell"><b>六</b>项专利软著</div>
      </div>
    </div>
  </header>

  <!-- ================= 项目分组 ================= -->
  {groups.map((g) => (
    <section id={g.id} class="section">
      <div class="wrap">
        <div class="section-head reveal">
          <h2>{g.name}</h2>
          <span class="no">{g.no}</span>
        </div>
        <p class="section-desc reveal">{g.desc}</p>
        {g.ids.map((id) => {
          const p = byId[id];
          return p ? <ProjectCard project={p} /> : null;
        })}
      </div>
    </section>
  ))}

  <!-- ================= 开源项目 ================= -->
  <section id="opensource" class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>开源项目</h2>
        <span class="no">五</span>
      </div>
      {osIds.map((id) => {
        const repo = byId[id];
        return repo ? <OsRow repo={repo} /> : null;
      })}
    </div>
  </section>

  <!-- ================= 荣誉与专利 ================= -->
  <section id="honors" class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>荣誉与专利</h2>
        <span class="no">六</span>
      </div>

      <p class="honor-line reveal">
        {honors.map((h, i) => (
          <>
            {i > 0 && <span class="sep">／</span>}
            {h}
          </>
        ))}
      </p>

      <div class="award-list reveal">
        {competitions.map((c) => (
          <div class="award-item">
            <span class="name">{c.name}</span>
            <span class="note">{c.note}</span>
            <span class="date">{c.date}</span>
          </div>
        ))}
      </div>

      <h3 class="reveal" style="font-family:var(--serif);font-size:18px;font-weight:600;margin:42px 0 16px;">专利与软件著作权</h3>
      <div class="patent-list reveal">
        {patents.map((p) => (
          <div class="patent-item">
            <span class="name">{p.name}</span>
            <span class="no">{p.no}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 页脚 ================= -->
  <footer class="footer">
    <div class="wrap footer-inner">
      <span>© 2026 房家辉 · <a href="mailto:jiahui.fang@ieee.org">jiahui.fang@ieee.org</a></span>
      <span>tan-bai.github.io</span>
    </div>
  </footer>
</Base>
