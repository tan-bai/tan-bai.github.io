---
import Base from '../layouts/Base.astro';
import Project from '../components/Project.astro';
import CertificateWall from '../components/CertificateWall.astro';
import { profile, pillars, lineage, timeline, honors, awards } from '../data/site';

const nav = [
  { href: '#work', label: '项目' },
  { href: '#path', label: '路径' },
  { href: '#recognition', label: '荣誉' },
  { href: '#contact', label: '联系' },
];
---

<Base>
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-name" href="#top">{profile.name}</a>
      <div class="nav-links">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </div>
    </div>
  </nav>

  <main class="page">
    <!-- ============================ Hero ============================ -->
    <header class="hero" id="top">
      <div class="hero-text">
        <p class="status"><span class="status-dot" aria-hidden="true"></span>{profile.status}</p>
        <h1>{profile.name}<span lang="en">{profile.nameEn}</span></h1>
        <p class="headline">{profile.headline}</p>
        <p class="bio">{profile.bio}</p>
        <ul class="edu">
          {profile.education.map((e) => (
            <li><b>{e.school}</b><span>{e.detail}</span><span class="edu-date">{e.date}</span></li>
          ))}
        </ul>
        <p class="hero-links">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub<span aria-hidden="true">↗</span></a>
          <a href={profile.blog} target="_blank" rel="noopener noreferrer">博客<span aria-hidden="true">↗</span></a>
        </p>
      </div>
      <figure class="hero-photo">
        <img src={profile.photo} alt={`${profile.name}的照片`} width="295" height="399" fetchpriority="high" />
      </figure>

      <ol class="arc" aria-label="成长路径">
        {timeline.map((s) => (
          <li><a href="#path"><span class="arc-no">{s.no}</span>{s.name}</a></li>
        ))}
      </ol>
    </header>

    <!-- ============================ Work ============================ -->
    <section class="section" id="work" data-spy>
      <header class="section-head">
        <h2>代表项目</h2>
        <p>按影响力排序，点击图片或视频可放大查看。</p>
      </header>

      {pillars.map((pl) => (
        <section class="pillar" id={pl.id} aria-labelledby={`${pl.id}-h`}>
          <header class="pillar-head reveal">
            <span class="pillar-no">{pl.no}</span>
            <h3 id={`${pl.id}-h`}>{pl.name}</h3>
            <p>{pl.thesis}</p>
          </header>

          {pl.id === 'vision' && (
            <ol class="lineage reveal" aria-label="实践过的检测架构">
              {lineage.map((l) => (
                <li><b>{l.name}</b><span>{l.note}</span></li>
              ))}
            </ol>
          )}

          {pl.feature && <Project project={pl.feature} variant="feature" />}

          <div class={pl.layout === 'compact' ? 'grid grid--compact' : pl.projects.length % 2 === 0 ? 'grid grid--even' : 'grid'}>
            {pl.projects.map((p) => (
              <Project project={p} variant={pl.layout === 'compact' ? 'compact' : 'card'} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ============================ Path ============================ -->
    <section class="section" id="path" data-spy>
      <header class="section-head">
        <h2>成长路径</h2>
        <p>从电路到感知，从机器人到 Agent。各阶段在时间上有所重叠。</p>
      </header>

      <ol class="timeline">
        {timeline.map((s) => (
          <li class="stage reveal">
            <div class="stage-head">
              <span class="stage-no">{s.no}</span>
              <h3>{s.name}</h3>
              <span class="stage-span">{s.span}</span>
              <p>{s.line}</p>
            </div>
            <ul class="rows">
              {s.items.map((m) => (
                <li>
                  <span class="row-date">{m.date}</span>
                  <div>
                    {m.href ? <a class="row-title" href={m.href}>{m.title}</a> : <span class="row-title">{m.title}</span>}
                    {m.detail && <p class="row-detail">{m.detail}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <!-- ========================= Recognition ======================== -->
    <section class="section" id="recognition" data-spy>
      <header class="section-head">
        <h2>荣誉与成果</h2>
      </header>

      <div class="recog reveal">
        <div>
          <h3>荣誉奖励</h3>
          <ul class="rows rows--tight">
            {honors.map((h) => (
              <li><span class="row-date">{h.date}</span><span class="row-title">{h.name}</span></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>竞赛获奖（节选）</h3>
          <ul class="rows rows--tight">
            {awards.map((a) => (
              <li><span class="row-date">{a.date}</span><div><span class="row-title">{a.name}</span><p class="row-detail">{a.result}</p></div></li>
            ))}
          </ul>
        </div>
      </div>

      <CertificateWall />
    </section>

    <!-- =========================== Contact ========================== -->
    <section class="section contact" id="contact" data-spy>
      <h2>一起做点能在真机上跑起来的东西。</h2>
      <p>
        正在寻找具身智能、机器人学习与 Agent 系统方向的科研与工程实习机会，欢迎邮件联系。
      </p>
      <p class="contact-links">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub<span aria-hidden="true">↗</span></a>
      </p>
    </section>

    <footer class="footer">
      <span>© 2026 {profile.name} {profile.nameEn}</span>
      <span>更新于 2026 年 10 月</span>
    </footer>
  </main>
</Base>
