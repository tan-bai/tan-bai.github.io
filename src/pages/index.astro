---
import Base from '../layouts/Base.astro';
import Project from '../components/Project.astro';
import Heatmap from '../components/Heatmap.astro';
import CertificateWall from '../components/CertificateWall.astro';
import { profile, pillars, lineage, timeline, honors, awards, patents } from '../data/site';

// bio 每段中的 [文字](#id) 拆成项目链接，**文字** 拆成加粗；~[文字](#id) 为静音链接（正文样式），
// 静音链接文字里仍可写 **…** 做局部朱批（如长标题只强调核心词）
const bio = profile.bio.map((para) =>
  para.split(/(~?\[[^\]]+\]\([^)]+\)|\*\*[^*]+\*\*)/).filter(Boolean).map((part) => {
    const link = part.match(/^~?\[([^\]]+)\]\(([^)]+)\)$/);
    if (link)
      return {
        href: link[2],
        quiet: part.startsWith('~'),
        segs: link[1].split(/(\*\*[^*]+\*\*)/).filter(Boolean).map((seg) => {
          const s = seg.match(/^\*\*([^*]+)\*\*$/);
          return s ? { text: s[1], strong: true } : { text: seg };
        }),
      };
    const strong = part.match(/^\*\*([^*]+)\*\*$/);
    return strong ? { text: strong[1], strong: true } : { text: part };
  })
);

const nav = [
  { href: '#work', label: '项目' },
  { href: '#path', label: '路径' },
  { href: '#recognition', label: '荣誉' },
  { href: '#contact', label: '联系' },
];
---

<Base>
  <nav class="nav">
    <div class="nav-inner">
      <a class="nav-name" href="#top">{profile.siteTitle}</a>
      <div class="nav-links">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </div>
    </div>
  </nav>

  <main class="page">
    <!-- ============================ Hero ============================ -->
    <header class="hero" id="top">
      <div class="hero-text">
        <a class="status" href="#contact"><span class="status-dot" aria-hidden="true"></span>{profile.status}</a>
        <h1>{profile.name}<span lang="en">{profile.nameEn}</span></h1>
        <ul class="edu">
          {profile.education.map((e) => (
            <li>
              {e.logo && <img class="edu-logo" src={e.logo} alt="" width="40" height="40" />}
              <div class="edu-text">
                <p class="edu-school"><b>{e.school}</b>{e.schoolEn && <span lang="en">{e.schoolEn}</span>}</p>
                <p class="edu-detail">{e.detail}{e.date && <span class="edu-date">{e.date}</span>}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="bio">
          {bio.map((para) => (
            <p>{para.map((b) => (b.href ? (
              <a href={b.href} class={b.quiet ? 'quiet' : undefined}>{b.segs.map((s) => (s.strong ? <b>{s.text}</b> : s.text))}</a>
            ) : b.strong ? <b>{b.text}</b> : b.text))}</p>
          ))}
        </div>
        <p class="hero-links">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub<span aria-hidden="true">↗</span></a>
          <a href={profile.blog} target="_blank" rel="noopener noreferrer">博客<span aria-hidden="true">↗</span></a>
        </p>
      </div>
      <figure class="hero-photo">
        <img src={profile.photo} alt={`${profile.name}的照片`} width="295" height="399" fetchpriority="high" />
      </figure>
      <Heatmap />

      <ol class="arc" aria-label="成长路径">
        {timeline.map((s) => (
          <li><a href="#path"><span class="arc-no">{s.no}</span>{s.name}</a></li>
        ))}
      </ol>
    </header>

    <!-- ============================ Work ============================ -->
    <section class="section" id="work" data-spy aria-label="代表项目">
      <h2 class="visually-hidden">代表项目</h2>

      {pillars.map((pl) => (
        <section class="pillar" id={pl.id} aria-labelledby={`${pl.id}-h`}>
          <header class="pillar-head reveal">
            <span class="pillar-no">{pl.no}</span>
            <h3 id={`${pl.id}-h`}>{pl.name}</h3>
            <p>{pl.thesis}</p>
          </header>

          {pl.id === 'vision' && (
            <ol class="lineage reveal" aria-label="实践过的检测架构">
              {lineage.map((l) => (
                <li><b>{l.name}</b><span>{l.note}</span></li>
              ))}
            </ol>
          )}

          {pl.features?.map((f, i) => <Project project={f} variant="feature" flip={i % 2 === 1} />)}

          {pl.moreLabel && <p class="more-label reveal">{pl.moreLabel}</p>}

          <div class={pl.layout === 'compact' ? 'grid grid--compact' : pl.projects.length % 2 === 0 ? 'grid grid--even' : 'grid'}>
            {pl.projects.map((p) => (
              <Project project={p} variant={pl.layout === 'compact' ? 'compact' : 'card'} quiet={!!pl.moreLabel} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <!-- ============================ Path ============================ -->
    <section class="section" id="path" data-spy>
      <header class="section-head">
        <h2>成长路径</h2>
        <p>从电路到感知，从机器人到 Agent。各阶段在时间上有所重叠。</p>
      </header>

      <ol class="timeline">
        {timeline.map((s) => (
          <li class="stage reveal">
            <div class="stage-head">
              <span class="stage-no">{s.no}</span>
              <h3>{s.name}</h3>
              <span class="stage-span">{s.span}</span>
              <p>{s.line}</p>
            </div>
            <ul class="rows">
              {s.items.map((m) => (
                <li>
                  <span class="row-date">{m.date}</span>
                  <div>
                    {m.href ? <a class="row-title" href={m.href}>{m.title}</a> : <span class="row-title">{m.title}</span>}
                    {m.detail && <p class="row-detail">{m.detail}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <!-- ========================= Recognition ======================== -->
    <section class="section" id="recognition" data-spy>
      <header class="section-head">
        <h2>荣誉 · 竞赛 · 专利</h2>
      </header>

      <div class="honor-chips reveal">
        {honors.map((h) => (
          <span class="chip">🏆 {h.name}{h.date && <span>{h.date}</span>}</span>
        ))}
      </div>

      <div class="award-list reveal">
        {awards.map((a) => (
          <div class="award-item">
            <span class="medal" aria-hidden="true">{a.medal}</span>
            <span class="name">{a.name}<small>{a.note}</small></span>
            <span class="date">{a.date}</span>
          </div>
        ))}
      </div>

      <h3 class="patents-title reveal">专利与软件著作权</h3>
      <div class="patent-grid reveal">
        {patents.map((p) => (
          <div class="patent-item">
            <span class="kind">{p.kind}</span>
            <span>{p.name}<small>{p.no}</small></span>
          </div>
        ))}
      </div>

      <CertificateWall />
    </section>

    <!-- =========================== Contact ========================== -->
    <section class="section contact" id="contact" data-spy>
      <h2>一起做点能在真机上跑起来的东西。</h2>
      <p>
        正在寻找具身智能、机器人学习与 Agent 系统方向的科研与工程实习机会，欢迎邮件联系。
      </p>
      <p class="contact-links">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub<span aria-hidden="true">↗</span></a>
      </p>
    </section>

    <footer class="footer">
      <span>© 2026 {profile.name} {profile.nameEn}</span>
      <span>更新于 2026 年 10 月</span>
    </footer>
  </main>
</Base>
