---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Jiahui Fang · Robotics & AI Agents',
  description =
    'Jiahui Fang (房家辉) — humanoid motion learning, autonomous research agents and edge vision, built on an electrical-engineering foundation. Open to research and engineering internships.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jiahui Fang" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content="https://tan-bai.github.io/" />
    <meta property="og:image" content="https://tan-bai.github.io/media/profile-photo.png" />
    <meta name="theme-color" content="#f8f7f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131416" media="(prefers-color-scheme: dark)" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%2317181b'/%3E%3Ctext x='50' y='68' font-size='56' font-family='Georgia, serif' font-style='italic' fill='%23f8f7f3' text-anchor='middle'%3EJ%3C/text%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />

    <!-- Shared lightbox: any element with data-media opens here -->
    <dialog class="lightbox" id="lightbox" aria-label="Media viewer">
      <button class="lb-btn lb-close" aria-label="Close">✕</button>
      <button class="lb-btn lb-prev" aria-label="Previous">←</button>
      <div class="lb-body">
        <div class="lb-stage"></div>
        <div class="lb-meta"><span class="lb-count"></span><span class="lb-cap"></span></div>
      </div>
      <button class="lb-btn lb-next" aria-label="Next">→</button>
    </dialog>

    <script>
      /* Reveal on scroll */
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.06, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      /* Nav gains a surface once the hero scrolls away */
      const nav = document.querySelector('.nav');
      const onScroll = () => nav?.classList.toggle('is-stuck', window.scrollY > 24);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      /* Nav highlight follows the section in view */
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav-links a')];
      const targets = [...document.querySelectorAll<HTMLElement>('[data-spy]')];
      const activate = (t: HTMLElement) =>
        links.forEach((a) => a.classList.toggle('is-active', a.getAttribute('href') === `#${t.id}`));
      const spy = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) activate(e.target as HTMLElement);
        },
        { rootMargin: '-35% 0px -60% 0px' }
      );
      targets.forEach((t) => spy.observe(t));
      window.addEventListener(
        'scroll',
        () => {
          if (targets.length && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2)
            activate(targets[targets.length - 1]);
        },
        { passive: true }
      );

      /* Videos play only while on screen */
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        const vio = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const v = e.target as HTMLVideoElement;
              if (e.isIntersecting) v.play().catch(() => {});
              else v.pause();
            }
          },
          { threshold: 0.4 }
        );
        document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => vio.observe(v));
      }

      /* Lightbox */
      type Item = { video?: string; image?: string; caption?: string };
      const lb = document.getElementById('lightbox') as HTMLDialogElement;
      const stage = lb.querySelector<HTMLElement>('.lb-stage')!;
      const cap = lb.querySelector<HTMLElement>('.lb-cap')!;
      const count = lb.querySelector<HTMLElement>('.lb-count')!;
      let items: Item[] = [];
      let cur = 0;

      const render = () => {
        const it = items[cur];
        stage.innerHTML = '';
        if (it.video) {
          const v = document.createElement('video');
          v.src = it.video;
          v.controls = true;
          v.playsInline = true;
          v.loop = true;
          stage.appendChild(v);
          v.play().catch(() => {});
        } else if (it.image) {
          const im = document.createElement('img');
          im.src = it.image;
          im.alt = it.caption ?? '';
          stage.appendChild(im);
        }
        cap.textContent = it.caption ?? '';
        count.textContent = `${cur + 1} / ${items.length}`;
      };
      const step = (d: number) => {
        cur = (cur + d + items.length) % items.length;
        render();
      };

      document.querySelectorAll<HTMLElement>('[data-media]').forEach((el) =>
        el.addEventListener('click', () => {
          items = JSON.parse(el.dataset.media!);
          cur = 0;
          lb.toggleAttribute('data-single', items.length < 2);
          render();
          lb.showModal();
        })
      );
      lb.querySelector('.lb-close')!.addEventListener('click', () => lb.close());
      lb.querySelector('.lb-prev')!.addEventListener('click', () => step(-1));
      lb.querySelector('.lb-next')!.addEventListener('click', () => step(1));
      lb.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t === lb || t.classList.contains('lb-body')) lb.close();
      });
      lb.addEventListener('keydown', (e) => {
        if (items.length < 2) return;
        if (e.key === 'ArrowLeft') step(-1);
        if (e.key === 'ArrowRight') step(1);
      });
      lb.addEventListener('close', () => (stage.innerHTML = ''));
    </script>
  </body>
</html>
