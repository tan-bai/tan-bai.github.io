---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '房家辉 Jiahui Fang · 具身智能与 AI for AI',
  description = '房家辉（Jiahui Fang），东南大学研究生，研究具身智能（空中视觉语言导航、VLA、无人机世界模型）与 AI for AI（自动化科研 Agent）。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="房家辉 Jiahui Fang" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content="https://tan-bai.github.io/" />
    <meta property="og:image" content="https://tan-bai.github.io/media/profile-photo.png" />
    <meta name="theme-color" content="#ffffff" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%2317181b'/%3E%3Ctext x='50' y='67' font-size='50' font-family='Songti SC, Noto Serif SC, serif' font-weight='600' fill='%23fbfaf7' text-anchor='middle'%3E房%3C/text%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&family=Noto+Sans+SC:wght@400;500&family=Noto+Serif+SC:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />

    <!-- 全站共用灯箱：任何带 data-media 的元素点击后在此展示 -->
    <dialog class="lightbox" id="lightbox" aria-label="媒体查看">
      <button class="lb-btn lb-close" aria-label="关闭">✕</button>
      <button class="lb-btn lb-prev" aria-label="上一项">←</button>
      <div class="lb-body">
        <div class="lb-stage"></div>
        <div class="lb-meta"><span class="lb-count"></span><span class="lb-cap"></span></div>
      </div>
      <button class="lb-btn lb-next" aria-label="下一项">→</button>
    </dialog>

    <script>
      /* 滚动显现 */
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.06, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      /* 导航：离开首屏后才出现底色与发丝线 */
      const nav = document.querySelector('.nav');
      const onScroll = () => nav?.classList.toggle('is-stuck', window.scrollY > 24);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      /* 导航与右侧目录高亮 */
      const spy = (selector: string, links: HTMLAnchorElement[]) => {
        const targets = [...document.querySelectorAll<HTMLElement>(selector)];
        const obs = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const id = (e.target as HTMLElement).id;
              links.forEach((a) => a.classList.toggle('is-active', a.getAttribute('href') === `#${id}`));
            }
          },
          { rootMargin: '-35% 0px -60% 0px' }
        );
        targets.forEach((t) => obs.observe(t));
      };
      spy('[data-spy]', [...document.querySelectorAll<HTMLAnchorElement>('.nav-links a')]);
      spy('.proj-group', [...document.querySelectorAll<HTMLAnchorElement>('.toc a')]);

      const toc = document.querySelector('.toc');
      const projects = document.getElementById('projects');
      if (toc && projects) {
        new IntersectionObserver(([e]) => toc.classList.toggle('is-visible', e.isIntersecting), {
          rootMargin: '-40% 0px -40% 0px',
        }).observe(projects);
      }

      /* 视频：进入视口才播放，滚出暂停 */
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const vids = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
      if (!reduced) {
        const vio = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const v = e.target as HTMLVideoElement;
              if (e.isIntersecting) v.play().catch(() => {});
              else v.pause();
            }
          },
          { threshold: 0.4 }
        );
        vids.forEach((v) => vio.observe(v));
      }

      /* 灯箱 */
      type Item = { video?: string; image?: string; caption?: string };
      const lb = document.getElementById('lightbox') as HTMLDialogElement;
      const stage = lb.querySelector<HTMLElement>('.lb-stage')!;
      const cap = lb.querySelector<HTMLElement>('.lb-cap')!;
      const count = lb.querySelector<HTMLElement>('.lb-count')!;
      let items: Item[] = [];
      let cur = 0;

      const render = () => {
        const it = items[cur];
        stage.innerHTML = '';
        if (it.video) {
          const v = document.createElement('video');
          v.src = it.video;
          v.controls = true;
          v.playsInline = true;
          v.loop = true;
          stage.appendChild(v);
          v.play().catch(() => {});
        } else if (it.image) {
          const im = document.createElement('img');
          im.src = it.image;
          im.alt = it.caption ?? '';
          stage.appendChild(im);
        }
        cap.textContent = it.caption ?? '';
        count.textContent = `${cur + 1} / ${items.length}`;
      };
      const step = (d: number) => {
        cur = (cur + d + items.length) % items.length;
        render();
      };

      document.querySelectorAll<HTMLElement>('[data-media]').forEach((el) =>
        el.addEventListener('click', () => {
          items = JSON.parse(el.dataset.media!);
          const requestedIndex = Number(el.dataset.mediaIndex ?? 0);
          cur = Number.isInteger(requestedIndex) && requestedIndex >= 0 && requestedIndex < items.length ? requestedIndex : 0;
          lb.toggleAttribute('data-single', items.length < 2);
          render();
          lb.showModal();
        })
      );
      lb.querySelector('.lb-close')!.addEventListener('click', () => lb.close());
      lb.querySelector('.lb-prev')!.addEventListener('click', () => step(-1));
      lb.querySelector('.lb-next')!.addEventListener('click', () => step(1));
      lb.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t === lb || t.classList.contains('lb-body')) lb.close();
      });
      lb.addEventListener('keydown', (e) => {
        if (items.length < 2) return;
        if (e.key === 'ArrowLeft') step(-1);
        if (e.key === 'ArrowRight') step(1);
      });
      lb.addEventListener('close', () => (stage.innerHTML = ''));
    </script>
  </body>
</html>
